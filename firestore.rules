rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'juniorazigiza@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'admin@ghanatelecom.com.gh' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Transactions: Airtime and bundle top-ups
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: Production carrier dispatch records
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Agents: Sub-agent commission and roster records
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }

    // Payouts: Sub-agent withdrawal requests
    match /payouts/{payoutId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit Logs: Regulatory immutable compliance logs
    match /auditLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings: System gateway operational parameters
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
